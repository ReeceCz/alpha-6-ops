@page
@inject ServerSettings Settings
@{ ViewData["Title"] = "Welcome to your flight deck"; ViewData["BodyClass"] = "portal-home"; }
<section class="auth-shell" aria-label="Alpha 6 account portal">
    <div class="aviation-panel">
        <div class="brand-line" aria-hidden="true"></div>
        <div class="eyebrow">ONE ACCOUNT. YOUR ENTIRE WORLD.</div>
        <h2>Every flight.<br />Connected.</h2>
        <p>From your first departure to an airline of your own.</p>
        <div class="flight-caption"><span>PERSONAL FLIGHT / SHARED OPERATIONS</span></div>
    </div>
    <div class="signin-panel">
        <div class="steps">01 ACCOUNT &nbsp; / &nbsp; 02 WORKSPACE</div>
        <div class="signin-content">
            <div class="eyebrow">WELCOME TO ALPHA 6 OPS</div>
            <h1>Your next flight<br />starts here.</h1>
            <p>Sign in to your flight deck. Your logbook, your airlines, one place.</p>
            @if (User.Identity?.IsAuthenticated == true) {
                <a class="button" href="/Account">Go to your workspaces <span aria-hidden="true">→</span></a>
                <p class="provider-note">You’re signed in. Choose where you want to fly.</p>
            } else if (Settings.IsConfigured) {
                <a class="button" href="/auth/login">Sign in securely <span aria-hidden="true">↗</span></a>
                <p class="provider-note">Use your email, passkey or connected account on the secure sign-in page.</p>
                <p class="new-account">New to Alpha 6? <a href="/auth/signup">Create an account</a></p>
            } else {
                <button class="button" disabled>Sign in securely</button>
                <p class="notice" role="status">Account registration is not available on this installation yet. You can explore the portal while account services are being connected.</p>
            }
        </div>
        <p class="signin-footnote">Flying as a Pilot is free. Your airlines stay connected to one account.</p>
    </div>
</section>

<section class="intro" aria-label="What Alpha 6 OPS is">
    <div class="intro-copy">
        <h2>Operations for Microsoft Flight Simulator 2024, on your desktop.</h2>
        <p>Alpha 6 OPS watches your flight as it happens — pushback, taxi, takeoff, cruise, approach, block-in — and turns it into a logbook you didn't have to type, a dispatch board your crew can see, and an airline you can run with friends. It's a Windows app that signs in with this account, not a website you fly from.</p>
    </div>
    <dl class="intro-facts">
        <div><dt>Flight phases</dt><dd>Detected from the sim, not self-reported</dd></div>
        <div><dt>Works offline</dt><dd>Sign in once; fly without a connection</dd></div>
        <div><dt>One account</dt><dd>Your own flying and every airline you join</dd></div>
    </dl>
</section>

<section class="two-worlds" aria-label="For pilots and for airlines">
    <article>
        <h2>For pilots</h2>
        <ul class="plain">
            <li><strong>Logbook</strong> — every flight recorded with times, route and aircraft, from the replay or the live sim.</li>
            <li><strong>Dispatch</strong> — import a SimBrief plan with your username saved to your account.</li>
            <li><strong>Tracking</strong> — see the flight's phase and progress as you fly.</li>
            <li><strong>Weather</strong> — briefings for departure and destination.</li>
        </ul>
    </article>
    <article>
        <h2>For airlines</h2>
        <ul class="plain">
            <li><strong>Crew roster</strong> — pilots, dispatchers and administrators, with roles you control.</li>
            <li><strong>Invitations</strong> — a code your invitee redeems once; nothing leaks in email.</li>
            <li><strong>Shared dispatch</strong> — the same board for everyone on the schedule.</li>
            <li><strong>Security</strong> — every administrative change asks for a fresh security check.</li>
        </ul>
    </article>
</section>

<section class="how" aria-label="How to start">
    <h2>How to start</h2>
    <ol class="how-steps">
        <li><span class="step-n">1</span><div><strong>Create your account</strong><p>Email and password, a passkey, or Microsoft / Google. Verify your email.</p></div></li>
        <li><span class="step-n">2</span><div><strong>Download for Windows</strong><p>Install Alpha 6 OPS and sign in once. It remembers you.</p></div></li>
        <li><span class="step-n">3</span><div><strong>Fly, or found an airline</strong><p>Log your first flight, join a crew with a code, or start your own operation.</p></div></li>
    </ol>
    <div class="actions">
        @if (User.Identity?.IsAuthenticated == true) { <a class="button" href="/Account">Go to your workspaces</a> }
        else if (Settings.IsConfigured) { <a class="button" href="/auth/signup">Create an account</a> }
        <a class="button secondary" href="/Download">Download for Windows</a>
        <a href="/Levels">See what each level includes</a>
    </div>
</section>
