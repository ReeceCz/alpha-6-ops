@using Alpha6Ops.Server.Pages.Home
<section class="h-band h-ops" aria-labelledby="ops-title">
    <div class="wrap">
        <div class="h-head">
            <div>
                <p class="h-index"><span>01</span> Operations</p>
                <h2 id="ops-title">One board for the whole operation.</h2>
                <p class="h-sub">Every leg on the schedule, its phase and its status, from the moment the brake comes off to the moment the engines stop.</p>
            </div>
            <dl class="h-answers">
                <div><dt>What it is</dt><dd>A Windows app plus this account portal for running a virtual airline in MSFS 2024.</dd></div>
                <div><dt>What it watches</dt><dd>Parking brake, ground speed, altitude, engines, and whether the aircraft is on the ground.</dd></div>
                <div><dt>What it automates</dt><dd>The four flight times, block and flight time, cruise level and top of descent, and a predicted gate arrival.</dd></div>
                <div><dt>What you get</dt><dd>A flight record and a PIREP for every flight, with no forms to fill in after landing.</dd></div>
            </dl>
        </div>

        <figure class="console night" aria-labelledby="console-caption">
            <div class="console-bar"><span class="console-title"><img src="/images/brand/s4-tile.svg" alt="" width="18" height="18" /> Operations board · sample rotation</span><span class="console-meta">Demonstration data · 2 Sep 2026</span></div>
            <div class="console-body">
                <div class="console-board table-scroll" tabindex="0" aria-label="Operations board, scrolls sideways on small screens">
                    <table>
                        <caption class="visually-hidden">Demonstration operations board for one aircraft's rotation</caption>
                        <thead><tr><th scope="col">Flight</th><th scope="col">Route</th><th scope="col">Type</th><th scope="col">Sched OUT</th><th scope="col">OUT</th><th scope="col">IN</th><th scope="col">Phase</th><th scope="col">Status</th></tr></thead>
                        <tbody>
                        @foreach (var r in HomeContent.Board) {
                            <tr class="@(r.Flight == "S4601" ? "is-selected" : null)" aria-current="@(r.Flight == "S4601" ? "true" : null)">
                                <th scope="row" class="mono">@r.Flight</th><td class="mono">@r.From → @r.To</td><td class="mono">@r.Aircraft</td>
                                <td class="mono">@r.SchedOut</td><td class="mono">@r.ActualOut</td><td class="mono">@r.ActualIn</td><td>@r.Phase</td>
                                <td><span class="flight-status @r.StatusCss">@r.Status</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="console-detail" aria-label="Selected flight S4601">
                    <div class="detail-head"><div><p class="mono detail-flight">S4601</p><p class="detail-route"><span class="mono">KMKE</span> Milwaukee → <span class="mono">KORD</span> Chicago O'Hare · <span class="mono">A20N</span></p></div><span class="flight-status on-time">On time</span></div>
                    <ol class="detail-track" aria-label="Flight times">
                        @foreach (var p in HomeContent.Phases) { <li><span class="code">@p.Code</span><span class="mono">@p.Time</span></li> }
                    </ol>
                    <dl class="detail-facts">
                        <div><dt>Sched OUT</dt><dd class="mono">1800Z</dd></div><div><dt>Sched IN</dt><dd class="mono">1915Z</dd></div>
                        <div><dt>Block time</dt><dd class="mono">1 h 07</dd></div><div><dt>Flight time</dt><dd class="mono">0 h 47</dd></div>
                        <div><dt>Phase</dt><dd>Block in</dd></div><div><dt>Next leg</dt><dd><span class="mono">S4602</span> +25 min</dd></div>
                    </dl>
                    <div class="detail-log">
                        <p class="detail-log-title">Event log</p>
                        <ol>@foreach (var e in HomeContent.Log) { <li><span class="mono">@e.Time</span><span class="code">@e.Code</span><span>@e.Text</span></li> }</ol>
                    </div>
                </div>
            </div>
            <figcaption id="console-caption" class="console-caption">Demonstration flight. Fields follow the desktop app's flight tracking and debrief views. S4602 is late because the aircraft arrived from S4601 too close to its scheduled departure, and the delay carries down the rotation.</figcaption>
        </figure>
    </div>
</section>
