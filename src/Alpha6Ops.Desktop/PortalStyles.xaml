<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Account portal look (Segoe UI, navy/gold). Shared by AccountWindow and the account dialogs. -->
  <Style x:Key="PortalText" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="#E8EDF2"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="PortalScrollBar" TargetType="ScrollBar">
    <Setter Property="Width" Value="7"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#425565" CornerRadius="3" Margin="1,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
      </Track></Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PortalButton" TargetType="Button">
    <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#DCE6EF"/><Setter Property="Background" Value="#121F2A"/><Setter Property="BorderBrush" Value="#304050"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="20,15"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter>
      </Border><ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#E5C44A"/><Setter Property="Foreground" Value="#F1D66A"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#C3A94E"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.6"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PortalPrimary" TargetType="Button" BasedOn="{StaticResource PortalButton}"><Setter Property="Background" Value="#E5C44A"/><Setter Property="Foreground" Value="#101923"/><Setter Property="BorderBrush" Value="#E5C44A"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F4D75F"/><Setter Property="Foreground" Value="#101923"/></Trigger></Style.Triggers></Style>
  <Style x:Key="PortalLink" TargetType="Button" BasedOn="{StaticResource PortalButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="2,5"/></Style>
  <Style x:Key="WorkspaceCard" TargetType="Button" BasedOn="{StaticResource PortalButton}"><Setter Property="Padding" Value="24"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#96A6B4"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="PortalInput" TargetType="TextBox">
    <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#E8EDF2"/><Setter Property="Background" Value="#121F2A"/><Setter Property="CaretBrush" Value="#E8EDF2"/>
    <Setter Property="Padding" Value="14"/><Setter Property="BorderBrush" Value="#3A4B5B"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#C3A94E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ButtonLabel" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
  <Style x:Key="ButtonIcon" TargetType="TextBlock" BasedOn="{StaticResource ButtonLabel}"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="PortalCheck" TargetType="CheckBox"><Setter Property="Foreground" Value="#E8EDF2"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="PortalCombo" TargetType="ComboBox" BasedOn="{StaticResource OpsCombo}"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#121F2A"/><Setter Property="BorderBrush" Value="#3A4B5B"/><Setter Property="Padding" Value="12,10"/></Style>
</ResourceDictionary>
