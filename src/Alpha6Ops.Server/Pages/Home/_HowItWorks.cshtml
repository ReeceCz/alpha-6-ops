@using Alpha6Ops.Server.Pages.Home
<section class="h-band h-how" aria-labelledby="how-title">
    <div class="wrap">
        <p class="h-index"><span>03</span> How it works</p>
        <h2 id="how-title">Fly normally. S4 OPS keeps the record.</h2>
        <ol class="route-steps">
            @for (var i = 0; i < HomeContent.Steps.Length; i++) {
                var step = HomeContent.Steps[i];
                <li><span class="route-fixpoint" aria-hidden="true"></span><p class="route-n mono">WPT @((i + 1).ToString("00"))</p><h3>@step.Title</h3><p>@step.Text</p></li>
            }
        </ol>
    </div>
</section>
