<Window x:Class="Alpha6Ops.Desktop.AccountWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Segoe UI" Foreground="#E8EDF2" Background="#0C141D">
  <Window.Resources>
    <Style TargetType="TextBlock" BasedOn="{StaticResource PortalText}"/>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PortalScrollBar}"/>
  </Window.Resources>
  <Grid x:Name="InteractionRoot" Background="#0C141D">
    <Grid x:Name="LoginPage">
      <Grid.ColumnDefinitions><ColumnDefinition Width="0.46*"/><ColumnDefinition Width="0.54*"/></Grid.ColumnDefinitions>
      <Grid Background="#0D1D27" ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Rectangle Grid.RowSpan="3"><Rectangle.Fill><ImageBrush ImageSource="Assets/Dashboard/hero-unbranded.png" Stretch="UniformToFill" AlignmentX="Right"/></Rectangle.Fill></Rectangle>
        <Rectangle Grid.RowSpan="3"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F00B1B26" Offset="0"/><GradientStop Color="#E00B1B26" Offset="0.32"/><GradientStop Color="#600B1B26" Offset="0.64"/><GradientStop Color="#F5091720" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
        <StackPanel Orientation="Horizontal" Margin="40,36,32,0">
          <Border Width="36" Height="36" BorderBrush="#E5C44A" BorderThickness="1"><TextBlock Text="A6" FontSize="18" FontWeight="Bold" Foreground="#E5C44A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="ALPHA 6" FontWeight="SemiBold" FontSize="15" Foreground="White"/><TextBlock Text="FLIGHT OPERATIONS" FontFamily="Consolas" FontSize="9" Foreground="#ACBDC7" Margin="0,3,0,0"/></StackPanel>
        </StackPanel>
        <Grid Grid.Row="1" Margin="40,48,34,20">
          <StackPanel VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal"><Rectangle Width="20" Height="2" Fill="#E5C44A" Margin="0,0,10,0"/><TextBlock Text="ONE ACCOUNT. YOUR ENTIRE WORLD." Style="{StaticResource Eyebrow}" Foreground="#BCCBD5"/></StackPanel>
            <TextBlock Text="Every flight.&#xA;Connected." FontSize="49" FontWeight="SemiBold" Foreground="White" LineHeight="57" Margin="0,20,0,16"/>
            <TextBlock Text="From your first departure to an airline of your own." FontSize="15" Foreground="#BCCBD5" LineHeight="24" MaxWidth="315" HorizontalAlignment="Left"/>
          </StackPanel>
          <Grid Height="110" VerticalAlignment="Bottom" Margin="0,0,0,4" Opacity="0.85">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="PERSONAL FLIGHT  /  SHARED OPERATIONS" Style="{StaticResource Eyebrow}" Foreground="#D8E1E6"/>
            <Grid Grid.Row="1" Margin="0,8,0,4">
              <Path Data="M 0,44 C 100,-8 210,-8 360,44" Stroke="#D5C16A" StrokeThickness="1" Stretch="Fill" Margin="8,12,8,8"/>
              <Ellipse Width="7" Height="7" Fill="#E5C44A" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5,0,0,4"/>
              <Ellipse Width="7" Height="7" Stroke="#E5C44A" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,4"/>
              <TextBlock Text="✈" FontFamily="Segoe UI Symbol" Foreground="#E5C44A" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-1,0,0"/>
            </Grid>
            <Grid Grid.Row="2"><TextBlock Text="YOUR FLIGHT DECK" Style="{StaticResource Eyebrow}" Foreground="#93A8B6"/><TextBlock Text="YOUR VIRTUAL AIRLINES" Style="{StaticResource Eyebrow}" Foreground="#93A8B6" HorizontalAlignment="Right"/></Grid>
          </Grid>
        </Grid>
        <Border Grid.Row="2" Margin="40,0,40,28" BorderBrush="#354652" BorderThickness="0,1,0,0" Padding="0,20,0,0"><Grid><TextBlock Text="BUILT FOR VIRTUAL AVIATION" Style="{StaticResource Eyebrow}" Foreground="#91A5B3"/><TextBlock Text="A6 / OPS" Style="{StaticResource Eyebrow}" Foreground="#91A5B3" HorizontalAlignment="Right"/></Grid></Border>
      </Grid>
      <Grid x:Name="LoginFrame" Grid.Column="1" Margin="56,34,56,26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><TextBlock Text="01  ACCOUNT     /     02  WORKSPACE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><Button x:Name="HelpButton" Content="Help ↗" Style="{StaticResource PortalLink}" HorizontalAlignment="Right" Tag="Support" Click="Portal_Click"/></Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid x:Name="LoginBody" MinHeight="540" VerticalAlignment="Stretch">
            <StackPanel x:Name="LoginForm" MaxWidth="370" VerticalAlignment="Center" Margin="0,16">
              <TextBlock Text="WELCOME TO ALPHA 6 OPS" Style="{StaticResource Eyebrow}" Foreground="#D6B84F"/>
              <TextBlock x:Name="LoginHeading" Text="Your next flight&#xA;starts here." FontSize="36" FontWeight="SemiBold" LineHeight="44" Margin="0,10,0,8"/>
              <TextBlock x:Name="LoginDescription" Text="Sign in to your flight deck. Your logbook, your airlines, one place." FontSize="14" Foreground="#A2B0BD" LineHeight="22" Margin="0,0,0,18"/>
              <Label Target="{Binding ElementName=EmailInput}" Padding="0" Margin="0,0,0,9"><TextBlock Text="Email address" FontSize="12" FontWeight="SemiBold" Foreground="#D8E1E8"/></Label>
              <Grid>
                <TextBox x:Name="EmailInput" Style="{StaticResource PortalInput}" MaxLength="254" AutomationProperties.Name="Email address"/>
                <TextBlock Text="you@example.com" Foreground="#899CAA" Margin="15,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=EmailInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              </Grid>
              <Label Target="{Binding ElementName=PasswordInput}" Padding="0" Margin="0,12,0,8" HorizontalContentAlignment="Stretch"><Grid><TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#D8E1E8"/><Button x:Name="ForgotButton" Content="Forgot password?" Style="{StaticResource PortalLink}" FontSize="11" HorizontalAlignment="Right" Click="Forgot_Click"/></Grid></Label>
              <PasswordBox x:Name="PasswordInput" MaxLength="128" Background="#0C1721" Foreground="#E8EDF2" BorderBrush="#3A4B5B" BorderThickness="1" Padding="12,10" FontSize="14" MinHeight="44" CaretBrush="#E5C44A" AutomationProperties.Name="Password"/>
              <Button x:Name="ContinueButton" Style="{StaticResource PortalPrimary}" Content="Sign in    →" Margin="0,16,0,0" IsDefault="True" Click="Continue_Click"/>
              <Grid x:Name="LoginDivider" Margin="0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Rectangle Height="1" Fill="#2A3A49"/><TextBlock Grid.Column="1" Text="or" FontSize="12" Foreground="#96A6B4" Margin="14,0"/><Rectangle Grid.Column="2" Height="1" Fill="#2A3A49"/></Grid>
              <Button x:Name="OtherLoginButton" Style="{StaticResource PortalButton}" Content="Passkey, Microsoft or Google    ↗" Click="OtherLogin_Click"/>
              <TextBlock x:Name="LoginOptionsHint" Text="Opens the secure sign-in page in your browser." FontSize="11" Foreground="#A2B0BD" TextAlignment="Center" Margin="0,8,0,14"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="New to Alpha 6?" FontSize="12" Foreground="#A2B0BD" VerticalAlignment="Center"/><Button x:Name="RegisterButton" Content="Create an account" Style="{StaticResource PortalLink}" Margin="7,0,0,0" Click="Register_Click"/><TextBlock Text="·" FontSize="12" Foreground="#5E7182" Margin="8,0" VerticalAlignment="Center"/><Button x:Name="RegisterBrowserButton" Content="in your browser ↗" Style="{StaticResource PortalLink}" FontSize="11" Click="RegisterBrowser_Click"/></StackPanel>
              <TextBlock x:Name="LoginStatus" FontSize="12" Foreground="#E5C977" Margin="0,18,0,0" LineHeight="19" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2"><Border x:Name="PreviewBanner" Background="#25271F" CornerRadius="4" Padding="10,8" Margin="0,0,0,14" Visibility="Collapsed"><TextBlock Text="DESIGN PREVIEW  ·  Continue to explore sample workspaces." FontSize="10" Foreground="#D6C17B" TextAlignment="Center"/></Border><TextBlock Text="Your password goes straight to the sign-in provider and is never stored by Alpha 6 OPS." TextAlignment="Center" FontSize="11" Foreground="#91A3B1"/></StackPanel>
      </Grid>
    </Grid>

    <Grid x:Name="WorkspacePage" Visibility="Collapsed" ClipToBounds="True">
      <Grid x:Name="WorkspaceBackdrop" IsHitTestVisible="False" RenderTransformOrigin="0.8,0.2">
        <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="BackdropScale" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="BackdropDrift" X="0" Y="0"/></TransformGroup></Grid.RenderTransform>
        <Grid.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True">
          <DoubleAnimation Storyboard.TargetName="BackdropScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.06" Duration="0:0:48"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="BackdropScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.06" Duration="0:0:48"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="BackdropDrift" Storyboard.TargetProperty="X" From="0" To="-26" Duration="0:0:48"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
        </Storyboard></BeginStoryboard></EventTrigger></Grid.Triggers>
        <Rectangle Height="540" VerticalAlignment="Top" Opacity="0.72">
          <Rectangle.Fill><ImageBrush ImageSource="Assets/Dashboard/workspace-backdrop.jpg" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Top"/></Rectangle.Fill>
          <Rectangle.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#40000000" Offset="0"/><GradientStop Color="#A0000000" Offset="0.5"/><GradientStop Color="#FF000000" Offset="0.8"/></LinearGradientBrush></Rectangle.OpacityMask>
        </Rectangle>
        <Rectangle Height="540" VerticalAlignment="Top"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#000C141D" Offset="0"/><GradientStop Color="#000C141D" Offset="0.30"/><GradientStop Color="#C80C141D" Offset="0.70"/><GradientStop Color="#FF0C141D" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
        <Rectangle Height="540" VerticalAlignment="Top"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#D00C141D" Offset="0"/><GradientStop Color="#000C141D" Offset="0.55"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
      </Grid>
      <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Width="400" Height="200" Margin="0,44,72,0" IsHitTestVisible="False">
        <Path Data="M 0,140 C 110,20 260,10 400,100" Stroke="#59E5C44A" StrokeThickness="1"/>
        <Ellipse Width="5" Height="5" Fill="#E5C44A" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-2,138,0,0"/>
        <Ellipse Width="5" Height="5" Stroke="#E5C44A" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="398,98,0,0"/>
        <TextBlock Text="✈" FontFamily="Segoe UI Symbol" Foreground="#E5C44A" FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-8,-9,0,0">
          <TextBlock.RenderTransform><MatrixTransform x:Name="PlaneTransform"/></TextBlock.RenderTransform>
          <TextBlock.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever">
            <MatrixAnimationUsingPath Storyboard.TargetName="PlaneTransform" Storyboard.TargetProperty="Matrix" Duration="0:0:36" DoesRotateWithTangent="True"><MatrixAnimationUsingPath.PathGeometry><PathGeometry Figures="M 0,140 C 110,20 260,10 400,100"/></MatrixAnimationUsingPath.PathGeometry></MatrixAnimationUsingPath>
          </Storyboard></BeginStoryboard></EventTrigger></TextBlock.Triggers>
        </TextBlock>
      </Grid>
      <Grid Margin="44,25,44,25">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,12,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="40" Height="40" Background="#0F1922" BorderBrush="#E5C44A" BorderThickness="1" CornerRadius="4"><TextBlock Text="A6" Foreground="#E5C44A" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="ALPHA 6 OPS" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,20,0"/><TextBlock Text="/" FontSize="13" Foreground="#6E828F" VerticalAlignment="Center" Margin="0,0,20,0"/><TextBlock Text="WORKSPACES" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Grid Width="40" Height="40" Margin="0,0,12,0">
            <Border Background="#131F29" BorderBrush="#3A4B5B" BorderThickness="1" CornerRadius="4" ClipToBounds="True"><Grid><TextBlock x:Name="AccountInitialsText" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="AccountAvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/></Grid></Border>
            <Ellipse x:Name="PresenceDot" Width="9" Height="9" Fill="#5FAE6E" Stroke="#0D1D27" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"/>
          </Grid>
          <StackPanel VerticalAlignment="Center"><TextBlock x:Name="AccountNameText" FontSize="13"/><TextBlock x:Name="AccountEmailText" Style="{StaticResource Eyebrow}" Margin="0,5,0,0"/></StackPanel>
          <Rectangle Width="1" Height="30" Fill="#2A3A49" Margin="22,0,22,0" VerticalAlignment="Center"/>
          <Button x:Name="LogbookButton" Style="{StaticResource PortalLink}" FontSize="14" Margin="0,0,18,0" Click="Logbook_Click" AutomationProperties.Name="Logbook"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource ButtonIcon}" Margin="0,0,10,0"/><TextBlock Text="Logbook" Style="{StaticResource ButtonLabel}"/></StackPanel></Button>
          <Button x:Name="ProfileButton" Style="{StaticResource PortalLink}" FontSize="14" Margin="0,0,18,0" Click="Profile_Click" AutomationProperties.Name="Pilot profile"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" Style="{StaticResource ButtonIcon}" Margin="0,0,10,0"/><TextBlock Text="Profile" Style="{StaticResource ButtonLabel}"/></StackPanel></Button>
          <Button x:Name="SignOutButton" Style="{StaticResource PortalLink}" FontSize="14" Click="SignOut_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="Sign out" Style="{StaticResource ButtonLabel}"/><TextBlock Text="&#xE72A;" Style="{StaticResource ButtonIcon}" Margin="12,0,0,0"/></StackPanel></Button>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,6,12,6">
          <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal"><Rectangle Width="30" Height="2" Fill="#E5C44A" Margin="0,0,12,0"/><TextBlock Text="02  /  SELECT YOUR WORKSPACE" Style="{StaticResource Eyebrow}" FontSize="11" Foreground="#C9D4DC"/></StackPanel>
              <TextBlock Text="Where are you flying today?" FontSize="37" FontWeight="SemiBold" Margin="0,12,0,6"/>
              <TextBlock Text="Fly independently or connect with your crew. You can switch workspaces anytime." FontSize="14.5" Foreground="#A2B0BD"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="24,0,0,0">
              <TextBlock x:Name="ConnectionText" Style="{StaticResource Eyebrow}" Foreground="#A6C4AA" TextAlignment="Right"/>
              <TextBlock Text="GLOBAL&#xA;FLIGHT OPERATIONS" Style="{StaticResource Eyebrow}" Foreground="#AFBFCB" TextAlignment="Right" LineHeight="15" Margin="0,8,0,18"/>
              <TextBlock Text="ALT  37,000 FT" Style="{StaticResource Eyebrow}" Foreground="#C9D4DC" TextAlignment="Right"/>
              <TextBlock Text="SPD  492 KT" Style="{StaticResource Eyebrow}" Foreground="#C9D4DC" TextAlignment="Right" Margin="0,3,0,0"/>
              <TextBlock Text="TRK  284°" Style="{StaticResource Eyebrow}" Foreground="#C9D4DC" TextAlignment="Right" Margin="0,3,0,0"/>
            </StackPanel>
          </Grid>
          <Button x:Name="PersonalCard" Style="{StaticResource WorkspaceCard}" Padding="24" MinHeight="170" Click="Personal_Click" AutomationProperties.Name="Flying as a Pilot, personal workspace">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
              <Grid Grid.ColumnSpan="3" Margin="-24" ClipToBounds="True"><Grid.ColumnDefinitions><ColumnDefinition Width="0.4*"/><ColumnDefinition Width="0.6*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="1" CornerRadius="0,5,5,0"><Border.Background><ImageBrush ImageSource="Assets/Dashboard/workspace-runway.jpg" Stretch="UniformToFill" Viewbox="0.15,0.14,0.7,0.64" AlignmentX="Center" AlignmentY="Center"/></Border.Background>
                  <Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#B0000000" Offset="0.32"/><GradientStop Color="#FF000000" Offset="0.55"/></LinearGradientBrush></Border.OpacityMask></Border>
                <Border Grid.Column="1" CornerRadius="0,5,5,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#90121F2A" Offset="0"/><GradientStop Color="#00121F2A" Offset="0.3"/><GradientStop Color="#00121F2A" Offset="0.6"/><GradientStop Color="#C8121F2A" Offset="1"/></LinearGradientBrush></Border.Background></Border>
              </Grid>
              <Border Width="84" Height="84" CornerRadius="6" Background="#0F1922" BorderBrush="#E5C44A" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,28,0"><TextBlock Text="✈" FontFamily="Segoe UI Symbol" FontSize="36" Foreground="#E5C44A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="Flying as a Pilot" FontSize="28" FontWeight="SemiBold"/><Button x:Name="PlanButton" Style="{StaticResource PortalLink}" Background="#0F1B1A" BorderBrush="#3E5A46" BorderThickness="1" Padding="10,5" Margin="18,4,0,0" VerticalAlignment="Center" Click="Plan_Click" AutomationProperties.Name="Account level"><StackPanel Orientation="Horizontal"><TextBlock x:Name="PlanText" Style="{StaticResource Eyebrow}" FontSize="11" FontWeight="Bold" Foreground="#8FD19A"/><TextBlock Text="&#xE70D;" Style="{StaticResource ButtonIcon}" FontSize="9" Foreground="#8FD19A" Margin="8,0,0,0"/></StackPanel></Button></StackPanel><TextBlock Text="Your logbook, dispatch, flight tracking and weather. All in your own space." FontSize="14" Foreground="#A2B0BD" Margin="0,10,12,18"/><TextBlock Text="LOGBOOK    /    DISPATCH    /    TRACKING    /    WEATHER" Style="{StaticResource Eyebrow}" FontSize="11" Foreground="#C9D4DC"/></StackPanel>
              <Grid Grid.Column="2" Margin="0,-24,-24,-24">
                <TextBlock x:Name="PersonalSelected" Style="{StaticResource Eyebrow}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0"/>
                <TextBlock Text="&#xE76C;" Style="{StaticResource ButtonIcon}" FontSize="14" Foreground="#C9D4DC" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,18">
                  <TextBlock Text="SAME SKY." Style="{StaticResource Eyebrow}" Foreground="#A9B8C4" HorizontalAlignment="Right"/>
                  <TextBlock Text="A BRIGHTER TOMORROW." Style="{StaticResource Eyebrow}" Foreground="#A9B8C4" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Button>
          <Grid Margin="0,20,0,10"><StackPanel Orientation="Horizontal"><Rectangle Width="20" Height="2" Fill="#E5C44A" Margin="0,0,10,0"/><TextBlock x:Name="AirlineCountText" Style="{StaticResource Eyebrow}" FontSize="11" Foreground="#C9D4DC" VerticalAlignment="Center"/></StackPanel><Button x:Name="ManageButton" Tag="Account" Style="{StaticResource PortalLink}" FontSize="14" HorizontalAlignment="Right" Click="Portal_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="Manage on the web" Style="{StaticResource ButtonLabel}"/><TextBlock Text="&#xE8A7;" Style="{StaticResource ButtonIcon}" FontSize="12" Margin="12,0,0,0"/></StackPanel></Button></Grid>
          <SystemControls:UniformGrid xmlns:SystemControls="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" x:Name="AirlineCards" Columns="2" Margin="0,0,-16,0"/>
          <Grid x:Name="EmptyAirlines" MinHeight="126" Margin="0,0,0,14" Visibility="Collapsed">
            <Rectangle Fill="#0F1A24" RadiusX="6" RadiusY="6" Stroke="#3A4B5B" StrokeThickness="1" StrokeDashArray="4 3"/>
            <Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
              <Grid Grid.ColumnSpan="3" Margin="-24" ClipToBounds="True"><Grid.ColumnDefinitions><ColumnDefinition Width="0.42*"/><ColumnDefinition Width="0.58*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="1" CornerRadius="0,5,5,0" Opacity="0.7"><Border.Background><ImageBrush ImageSource="Assets/Dashboard/workspace-routes.jpg" Stretch="UniformToFill" Viewbox="0.05,0.08,0.9,0.8" AlignmentX="Center" AlignmentY="Center"/></Border.Background>
                  <Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#A0000000" Offset="0.35"/><GradientStop Color="#FF000000" Offset="0.6"/><GradientStop Color="#B0000000" Offset="1"/></LinearGradientBrush></Border.OpacityMask></Border>
                <Border Grid.Column="1" CornerRadius="0,5,5,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#A00F1A24" Offset="0"/><GradientStop Color="#000F1A24" Offset="0.32"/><GradientStop Color="#000F1A24" Offset="0.68"/><GradientStop Color="#A00F1A24" Offset="1"/></LinearGradientBrush></Border.Background></Border>
              </Grid>
              <Border Width="84" Height="84" CornerRadius="6" Background="#0F1922" BorderBrush="#3A4B5B" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,28,0"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#8FA3B1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Your crew is out there." FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Join with an invitation or create a virtual airline of your own." Foreground="#A2B0BD" FontSize="14.5" Margin="0,8,0,0"/></StackPanel>
              <Grid Grid.Column="2" Margin="0,-24,-24,-24">
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
                  <TextBlock Text="PEOPLE" Style="{StaticResource Eyebrow}" Foreground="#A9B8C4" HorizontalAlignment="Right"/>
                  <TextBlock Text="ROUTES" Style="{StaticResource Eyebrow}" Foreground="#A9B8C4" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                  <TextBlock Text="POSSIBILITIES" Style="{StaticResource Eyebrow}" Foreground="#A9B8C4" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                  <Rectangle Height="1" Fill="#3A4B5B" Width="28" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
          <Grid Margin="0,4,0,0"><TextBlock x:Name="CrewHintText" Text="A new crew. A new destination." FontSize="14" Foreground="#9EAFBD" VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="JoinButton" Style="{StaticResource PortalButton}" Padding="20,12" Margin="0,0,14,0" Click="Join_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71B;" Style="{StaticResource ButtonIcon}" Margin="0,0,12,0"/><TextBlock Text="Join with an invite" FontSize="14" Style="{StaticResource ButtonLabel}"/></StackPanel></Button>
            <Button x:Name="CreateButton" Style="{StaticResource PortalButton}" Padding="20,12" Click="Create_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource ButtonIcon}" Margin="0,0,12,0"/><TextBlock Text="Create an airline" FontSize="14" Style="{StaticResource ButtonLabel}"/></StackPanel></Button>
          </StackPanel></Grid>
          <Border x:Name="PreviewWorkspaceBanner" Background="#25271F" CornerRadius="4" Padding="12,9" Margin="0,14,0,0" Visibility="Collapsed"><TextBlock Text="DESIGN PREVIEW  ·  These memberships are examples. No account is signed in." Foreground="#D6C17B" FontSize="11"/></Border>
          <TextBlock x:Name="WorkspaceStatus" Foreground="#E5C977" FontSize="12" LineHeight="19" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="#304050" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,10,12,0">
        <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource PortalLink}" FontSize="15" VerticalAlignment="Center" Click="Back_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72B;" Style="{StaticResource ButtonIcon}" Margin="0,0,14,0"/><TextBlock Text="Back" Style="{StaticResource ButtonLabel}"/></StackPanel></Button>
            <Rectangle Grid.Column="1" Width="1" Height="40" Fill="#2A3A49" Margin="26,0,26,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock x:Name="SelectedTypeText" Style="{StaticResource Eyebrow}" FontSize="11" Foreground="#C9D4DC"/><TextBlock x:Name="SelectedNameText" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
            <Button x:Name="ReconnectButton" Grid.Column="3" Style="{StaticResource PortalButton}" FontSize="15" Padding="24,15" Margin="0,0,14,0" Click="Reconnect_Click" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource ButtonIcon}" FontSize="14" Margin="0,0,14,0"/><TextBlock x:Name="ReconnectLabel" Text="Reconnect" Style="{StaticResource ButtonLabel}"/></StackPanel></Button>
            <Button x:Name="OpenWorkspaceButton" Grid.Column="4" Style="{StaticResource PortalPrimary}" FontSize="15" Padding="34,15" Click="OpenWorkspace_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="Open workspace" FontWeight="SemiBold" Style="{StaticResource ButtonLabel}"/><TextBlock Text="&#xE72A;" Style="{StaticResource ButtonIcon}" FontSize="14" Margin="16,0,0,0"/></StackPanel></Button>
          </Grid>
          <Grid Margin="0,14,0,0"><Button x:Name="UpdatesButton" Style="{StaticResource PortalLink}" Padding="0" HorizontalAlignment="Left" Click="Updates_Click" AutomationProperties.Name="Download and updates"><TextBlock x:Name="FooterVersionText" Text="ALPHA 6 OPS" Style="{StaticResource Eyebrow}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button><TextBlock Text="FLY FURTHER TOGETHER  ————" Style="{StaticResource Eyebrow}" Foreground="#5E7280" HorizontalAlignment="Right"/></Grid>
        </StackPanel>
      </Border>
      </Grid>
    </Grid>
    <Button x:Name="CancelSignInButton" Content="Cancel sign-in" Style="{StaticResource PortalButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Visibility="Collapsed" Click="CancelSignIn_Click"/>
  </Grid>
</Window>
