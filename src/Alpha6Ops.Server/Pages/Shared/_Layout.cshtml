<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>@ViewData["Title"] · S4 OPS</title>
    <link rel="preload" href="~/fonts/b612-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    <link rel="icon" href="~/favicon.ico" sizes="48x48" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
</head>
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var path = Context.Request.Path.Value ?? "/";
    // One list drives the desktop bar and the phone menu, so the two can never disagree.
    var links = new (string Href, string Label)[] { ("/Levels", "Levels"), ("/Download", "Download"), ("/Support", "Help") };
    var version = typeof(Alpha6Ops.Server.ServerSettings).Assembly.GetName().Version?.ToString(3) ?? "0.0.0";
}
<body class="@ViewData["BodyClass"]">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
        <header class="topbar">
            <div class="topbar-inner">
                @* Lockup files are generated by tools/brand/build_logo.py. Breakpoint matches the 680px rule in site.css. *@
                <a class="logo-link" href="/">
                    <picture>
                        <source media="(max-width: 680px) and (prefers-color-scheme: light)" srcset="/images/brand/s4-lockup-compact-light.svg" />
                        <source media="(max-width: 680px)" srcset="/images/brand/s4-lockup-compact-dark.svg" />
                        <source media="(prefers-color-scheme: light)" srcset="/images/brand/s4-lockup-full-light.svg" />
                        <img src="/images/brand/s4-lockup-full-dark.svg" alt="Sierra 4 S4 OPS home" />
                    </picture>
                </a>
                <span class="topbar-state">Early access · MSFS 2024</span>
                <nav class="site-nav" aria-label="Main navigation">
                    @foreach (var (href, label) in links) { <a href="@href" aria-current="@(path.StartsWith(href, StringComparison.OrdinalIgnoreCase) ? "page" : null)">@label</a> }
                    @if (signedIn) {
                        <a class="nav-cta" href="/Account">My account</a>
                        <form method="post" asp-page="/Account/Index" asp-page-handler="Logout"><button class="text-button">Sign out</button></form>
                    } else { <a class="nav-cta" href="/auth/login">Sign in</a> }
                </nav>
                @* Phones: a native disclosure, so the menu works by touch and keyboard with no script (the CSP forbids it). *@
                <details class="site-menu">
                    <summary><span class="menu-icon" aria-hidden="true"></span>Menu</summary>
                    <nav aria-label="Main navigation (menu)">
                        @foreach (var (href, label) in links) { <a href="@href" aria-current="@(path.StartsWith(href, StringComparison.OrdinalIgnoreCase) ? "page" : null)">@label</a> }
                        @if (signedIn) {
                            <a href="/Account">My account</a>
                            <form method="post" asp-page="/Account/Index" asp-page-handler="Logout"><button class="text-button">Sign out</button></form>
                        } else { <a href="/auth/login">Sign in</a> }
                    </nav>
                </details>
            </div>
        </header>
        <main id="main">@RenderBody()</main>
        <footer class="site-footer">
            <div class="footer-inner">
                <div class="footer-brand">
                    <img src="/images/brand/s4-tile.svg" alt="" width="40" height="40" />
                    <p><strong>S4 OPS</strong> by Sierra 4, powered by RYNEL.<br />Airline operations for Microsoft Flight Simulator 2024.</p>
                </div>
                <nav class="footer-links" aria-label="Footer">
                    <div><h2>Product</h2><a href="/">Overview</a><a href="/Levels">Levels</a><a href="/Download">Download for Windows</a></div>
                    <div><h2>Account</h2>@if (signedIn) { <a href="/Account">Your workspaces</a><a href="/Account/Profile">Profile and your data</a> } else { <a href="/auth/login">Sign in</a><a href="/Support">Account help</a> }</div>
                    <div><h2>Help</h2><a href="/Support">Help and account security</a><a href="/Privacy">Privacy</a><a href="/Terms">Terms</a></div>
                </nav>
            </div>
            <div class="footer-strip">
                <div class="footer-inner">
                    <span>S4 OPS v@(version)</span><span>Windows desktop app</span><span>Microsoft Flight Simulator 2024</span><span>Not affiliated with Microsoft or Asobo Studio</span>
                </div>
            </div>
        </footer>
    </div>
</body>
</html>
