@using Alpha6Ops.Server.Pages.Home
@{
    // A split-flap departures board. Each tile is a short column of letters that the CSS scrolls through in steps
    // and settles on the real one: the flip of a Solari board, with no script. The fillers are fixed per tile, so
    // the page renders the same every time.
    const string Alphabet = "ABCDEFGHJKLMNPRSTUVWXYZ0123456789";
    string[] Stack(char final, int seed) => [.. Enumerable.Range(0, HomeContent.FlapSteps).Select(k => Alphabet[(seed * 7919 + k * 104729) % Alphabet.Length].ToString()), final.ToString()];
}
<section class="h-hero night" aria-labelledby="hero-title">
    <div class="wrap h-hero-inner">
        <p class="eyebrow">Airline operations for Microsoft Flight Simulator 2024</p>
        <h1 id="hero-title" class="visually-hidden">You fly the airplane. We'll run the airline.</h1>
        @foreach (var (layout, rows, cols) in new[] { ("wide", HomeContent.BoardWide, HomeContent.BoardWideColumns), ("narrow", HomeContent.BoardNarrow, HomeContent.BoardNarrowColumns) }) {
            <div class="board board-@layout" aria-hidden="true">
                <div class="board-bar"><span>Departures</span><span>S4 OPS · KMKE</span></div>
                @for (var r = 0; r < rows.Length; r++) {
                    var (text, accent) = rows[r];
                    var cells = text.PadRight(cols);
                    <div class="board-row @(accent ? "accent" : null)">
                        @for (var c = 0; c < cells.Length; c++) {
                            <span class="flap fd@(Math.Min(c + r * 3, HomeContent.FlapDelays - 1))"><span class="flap-stack">@foreach (var f in Stack(cells[c], c * 31 + r * 17 + cells[c])) { <span>@(f == " " ? "\u00a0" : f)</span> }</span></span>
                        }
                    </div>
                }
            </div>
        }
        <div class="h-hero-foot">
            <p class="h-lead">S4 OPS is a Windows desktop app that reads the aircraft state from the simulator, times every flight from off block to block in, and keeps your logbook and your virtual airline in one account.</p>
            <div><partial name="~/Pages/Home/_Actions.cshtml" /></div>
        </div>
    </div>
</section>
