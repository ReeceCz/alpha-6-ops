<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] · S4 OPS</title>
    <link rel="preload" href="~/fonts/barlow-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    <link rel="icon" href="~/favicon.ico" sizes="48x48" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
</head>
@inject Microsoft.Extensions.Options.IOptions<ReleaseSettings> Release
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var path = Context.Request.Path.Value ?? "/";
    // One list drives the desktop bar and the phone menu, so the two can never disagree.
    var links = new (string Href, string Label)[] { ("/Levels", "Levels"), ("/Download", "Download"), ("/Support", "Help") };
    // The version shown is the published desktop release, not the portal's own assembly version.
    var release = Release.Value;
}
<body class="@ViewData["BodyClass"]">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
        <header class="topbar">
            <div class="topbar-inner">
                <a class="brand" href="/" aria-label="Sierra 4 S4 OPS home"><img src="/images/brand/s4-tile.svg" alt="" width="34" height="34" /><span>SIERRA 4<small>AIRLINE OPERATIONS</small></span></a>
                <nav class="site-nav" aria-label="Main navigation">
                    @foreach (var (href, label) in links) { <a href="@href" aria-current="@(path.StartsWith(href, StringComparison.OrdinalIgnoreCase) ? "page" : null)">@label</a> }
                    @if (signedIn) {
                        <a class="nav-cta" href="/Account">My account</a>
                        <form method="post" asp-page="/Account/Index" asp-page-handler="Logout"><button class="text-button">Sign out</button></form>
                    } else { <a class="nav-cta" href="/auth/login">Sign in</a> }
                </nav>
                @* Phones: a native disclosure, so the menu works by touch and keyboard with no script (the CSP forbids it). *@
                <details class="site-menu">
                    <summary><span class="menu-icon" aria-hidden="true"></span>Menu</summary>
                    <nav aria-label="Main navigation (menu)">
                        @foreach (var (href, label) in links) { <a href="@href" aria-current="@(path.StartsWith(href, StringComparison.OrdinalIgnoreCase) ? "page" : null)">@label</a> }
                        @if (signedIn) {
                            <a href="/Account">My account</a>
                            <form method="post" asp-page="/Account/Index" asp-page-handler="Logout"><button class="text-button">Sign out</button></form>
                        } else { <a href="/auth/login">Sign in</a> }
                    </nav>
                </details>
            </div>
        </header>
        <main id="main">@RenderBody()</main>
        <footer class="site-footer">
            <div class="footer-row">
                <p><strong>S4 OPS</strong> by Sierra 4. Airline operations for Microsoft Flight Simulator 2024.</p>
                <nav aria-label="Footer"><a href="/Privacy">Privacy</a><a href="/Terms">Terms</a><a href="/Support">Help</a><a href="https://s4ops.com/">s4ops.com</a></nav>
                <p class="fine">@(release.Available ? "S4 OPS " + release.Version + " · " : "")Not affiliated with Microsoft or Asobo Studio.</p>
            </div>
        </footer>
    </div>
</body>
</html>
