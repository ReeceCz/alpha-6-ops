<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] · S4 OPS</title>
    <link rel="preload" href="~/fonts/barlow-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    <link rel="icon" href="~/favicon.ico" sizes="48x48" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
</head>
@inject Microsoft.Extensions.Options.IOptions<ReleaseSettings> Release
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var path = Context.Request.Path.Value ?? "/";
    // One list drives the desktop bar and the phone menu, so the two can never disagree.
    var links = new (string Href, string Label)[] { ("/Levels", "Levels"), ("/Download", "Download"), ("/Support", "Help") };
    // The version shown is the published desktop release, not the portal's own assembly version.
    var release = Release.Value;
    // Signed-in pilots share the public home page, never a portal address (those need an account).
    const string homeUrl = "https://s4ops.com/";
    const string shareText = "S4 OPS: airline operations for Microsoft Flight Simulator 2024. Ask for an invitation here:";
    var u = Uri.EscapeDataString(homeUrl);
    var t = Uri.EscapeDataString(shareText);
    var shareTargets = new (string Label, string Href)[]
    {
        ("Email", $"mailto:?subject={Uri.EscapeDataString("Fly with S4 OPS")}&body={t}%20{u}"),
        ("WhatsApp", $"https://wa.me/?text={t}%20{u}"),
        ("X", $"https://x.com/intent/tweet?text={t}&url={u}"),
        ("Reddit", $"https://www.reddit.com/submit?url={u}&title={Uri.EscapeDataString("S4 OPS for MSFS 2024")}"),
        ("Facebook", $"https://www.facebook.com/sharer/sharer.php?u={u}")
    };
}
<body class="@ViewData["BodyClass"]">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
        <header class="topbar">
            <div class="topbar-inner">
                <a class="brand" href="/"><img src="/images/brand/s4-tile.svg" alt="" width="34" height="34" /><span>SIERRA 4<small>AIRLINE OPERATIONS</small></span></a>
                <nav class="site-nav" aria-label="Main navigation">
                    @foreach (var (href, label) in links) { <a href="@href" aria-current="@(path.StartsWith(href, StringComparison.OrdinalIgnoreCase) ? "page" : null)">@label</a> }
                    @if (signedIn) {
                        <a class="nav-cta" href="/Account">My account</a>
                        <form method="post" asp-page="/Account/Index" asp-page-handler="Logout"><button class="text-button">Sign out</button></form>
                    } else { <a class="nav-cta" href="/auth/login">Sign in</a> }
                </nav>
                @* Phones: a native disclosure, so the menu works by touch and keyboard with no script (the CSP forbids it). *@
                <details class="site-menu">
                    <summary><span class="menu-icon" aria-hidden="true"></span>Menu</summary>
                    <nav aria-label="Main navigation (menu)">
                        @foreach (var (href, label) in links) { <a href="@href" aria-current="@(path.StartsWith(href, StringComparison.OrdinalIgnoreCase) ? "page" : null)">@label</a> }
                        @if (signedIn) {
                            <a href="/Account">My account</a>
                            <form method="post" asp-page="/Account/Index" asp-page-handler="Logout"><button class="text-button">Sign out</button></form>
                        } else { <a href="/auth/login">Sign in</a> }
                    </nav>
                </details>
            </div>
        </header>
        @if (signedIn) {
        <div class="homebar">
            <div class="homebar-inner">
                <a class="home-chip" href="@homeUrl">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg>
                    <span>S4 OPS home</span><span class="home-chip-url">s4ops.com</span>
                </a>
                @* A native disclosure: the portal runs no script, so there is no copy button; the link is selectable text. *@
                <details class="share">
                    <summary>
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>
                        <span>Share S4 OPS</span>
                    </summary>
                    <div class="share-panel">
                        <p class="eyebrow">Invite a fellow pilot</p>
                        <p class="share-lead">Send them the S4 OPS home page. They can read what it does and ask for an invitation there.</p>
                        <label for="share-link">Home page link</label>
                        <input id="share-link" class="share-link" type="text" readonly value="@homeUrl" />
                        <div class="share-targets">
                            @foreach (var (label, href) in shareTargets) {
                                <a href="@href" target="@(label == "Email" ? null : "_blank")" rel="noopener noreferrer">@label</a>
                            }
                        </div>
                    </div>
                </details>
            </div>
        </div>
        }
        <main id="main">@RenderBody()</main>
        <footer class="site-footer">
            <div class="footer-row">
                <p><strong>S4 OPS</strong> by Sierra 4. Airline operations for Microsoft Flight Simulator 2024.</p>
                <nav aria-label="Footer"><a href="/Privacy">Privacy</a><a href="/Terms">Terms</a><a href="/Support">Help</a><a href="https://s4ops.com/">s4ops.com</a></nav>
                <p class="fine">@(release.Available ? "S4 OPS " + release.Version + " · " : "")Not affiliated with Microsoft or Asobo Studio.</p>
            </div>
        </footer>
    </div>
</body>
</html>
