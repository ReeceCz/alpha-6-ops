<?xml version="1.0" encoding="utf-8"?>
<!-- Desktop: only the pinned WebView2 SDK and Windows reference packs; map assets remain local.
     Identity/Accounts/Server: maintained OIDC, EF Core + Npgsql, and test-host packages. Domain/replay projects remain dependency-free. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.Web.WebView2" />
      <package pattern="Microsoft.Windows.SDK.NET.Ref" />
      <package pattern="Microsoft.Windows.SDK.NET.Ref.*" />
      <package pattern="Microsoft.Windows.SDK.BuildTools" />
      <package pattern="Duende.IdentityModel*" />
      <package pattern="Microsoft.AspNetCore.*" />
      <package pattern="Microsoft.IdentityModel.*" />
      <package pattern="System.IdentityModel.Tokens.Jwt" />
      <package pattern="Microsoft.EntityFrameworkCore*" />
      <package pattern="Npgsql*" />
      <package pattern="Microsoft.Extensions.*" />
      <package pattern="Microsoft.Bcl.*" />
      <package pattern="System.Diagnostics.EventLog" />
    </packageSource>
  </packageSourceMapping>
</configuration>
