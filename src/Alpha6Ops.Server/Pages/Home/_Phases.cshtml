@using Alpha6Ops.Server.Pages.Home
<section class="h-band h-phases" aria-labelledby="phases-title">
    <div class="wrap">
        <div class="h-split-head">
            <div><p class="h-index"><span>02</span> Flight phases</p><h2 id="phases-title">Every phase recorded automatically.</h2></div>
            <p class="h-statement"><strong>Detected from the simulator. No forms after landing.</strong> S4 OPS records the four times airlines report for every flight, then works out block and flight time from them.</p>
        </div>
        <ol class="oooi" aria-label="Sample flight S4601, Milwaukee to Chicago O'Hare">
            @foreach (var p in HomeContent.Phases) {
                <li class="oooi-step">
                    <div class="oooi-mark"><span class="oooi-code">@p.Code</span><span class="oooi-time">@p.Time</span></div>
                    <h3>@p.Event</h3>
                    <p><span class="visually-hidden">Detected when: </span>@p.Detected</p>
                    @if (p.LegToNext is { } leg) { <p class="oooi-leg"><span class="visually-hidden">Then: </span>@leg</p> }
                </li>
            }
        </ol>
        <p class="h-fine">Sample flight S4601, KMKE to KORD: block time 1 h 07 min, flight time 47 min. A paused or slewed sim never triggers a phase change.</p>

        <div class="h-status">
            <h3 id="status-title">How the board shows a flight</h3>
            <dl class="status-grid" aria-labelledby="status-title">
                @foreach (var s in HomeContent.Statuses) { <div><dt><span class="flight-status @s.Css">@s.Label</span></dt><dd>@s.Meaning</dd></div> }
            </dl>
        </div>
    </div>
</section>
