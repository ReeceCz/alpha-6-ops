@using Alpha6Ops.Server.Pages.Home
<section class="h-band h-audiences" aria-labelledby="audiences-title">
    <div class="wrap">
        <p class="h-index"><span>04</span> Pilots and airlines</p>
        <h2 id="audiences-title" class="visually-hidden">For pilots and for airlines</h2>
        <div class="aud-split">
            <article class="aud aud-pilots" aria-labelledby="pilots-title">
                <p class="aud-for">For pilots</p>
                <h3 id="pilots-title">Your flight. Your logbook.</h3>
                <p class="aud-lead">Everything you need on the flight deck, in your own space, whether or not you fly for an airline.</p>
                <ul class="strips">
                    @foreach (var f in HomeContent.Pilots) { <li><span class="strip-code mono" aria-hidden="true">@f.Code</span><span><strong>@f.Title.</strong> @f.Text</span></li> }
                </ul>
            </article>
            <article class="aud aud-airlines" aria-labelledby="airlines-title">
                <p class="aud-for">For airlines and dispatchers</p>
                <h3 id="airlines-title">Run the airline together.</h3>
                <p class="aud-lead">Found an airline or join one with a code. Everyone works from the same schedule, fleet and crew list.</p>
                <ul class="plain aud-list">
                    @foreach (var f in HomeContent.Airlines) { <li><strong>@f.Title.</strong> @f.Text</li> }
                </ul>
                <table class="roles">
                    <caption>Roles in an airline</caption>
                    <thead><tr><th scope="col">Role</th><th scope="col">Can</th></tr></thead>
                    <tbody>@foreach (var r in HomeContent.Roles) { <tr><th scope="row">@r.Role</th><td>@r.Can</td></tr> }</tbody>
                </table>
            </article>
        </div>
    </div>
</section>
