@* Primary and secondary calls to action, by sign-in state. Never offers sign-up while account services are unconfigured. *@
@inject ServerSettings Settings
@if (User.Identity?.IsAuthenticated == true) {
    <div class="h-actions"><a class="button has-arrow" href="/Account">Go to your workspaces<span class="btn-arrow" aria-hidden="true"><svg viewBox="0 0 16 16" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" /></svg></span></a><a class="button secondary" href="/Download"><svg class="icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M2.5 13.5h11" /></svg>Download for Windows</a></div>
} else if (Settings.IsConfigured) {
    <div class="h-actions"><a class="button has-arrow" href="/auth/signup">Create your invited account<span class="btn-arrow" aria-hidden="true"><svg viewBox="0 0 16 16" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" /></svg></span></a><a class="button secondary" href="/Download"><svg class="icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M2.5 13.5h11" /></svg>Download for Windows</a></div>
    <p class="h-note">S4 OPS is invite-only while we test with a small group of pilots. Create your account with the email address you were invited with, or <a href="mailto:@Legal.Contact?subject=S4%20OPS%20invitation">ask us for an invitation</a>.</p>
    <p class="h-note">Already have an account? <a href="/auth/login">Sign in</a>. Email and password, a passkey, or your Microsoft or Google account.</p>
} else {
    <p class="notice" role="status">Account registration is not available on this installation yet. You can explore the portal while account services are being connected.</p>
    <div class="h-actions"><a class="button secondary" href="/Download"><svg class="icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M2.5 13.5h11" /></svg>Download for Windows</a></div>
}
