<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>@ViewData["Title"] · S4 OPS</title>
    <link rel="preload" href="~/fonts/b612-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
        <header class="topbar">
            <div class="brand">
                <a class="wordmark" href="/" aria-label="S4 OPS home"><span class="mark">S4</span><span class="wordmark-text">OPS</span></a>
                <nav aria-label="Main navigation">
                    <a href="/Levels">Levels</a>
                    <a href="/Download">Download</a>
                    <a href="/Support">Help</a>
                    @if (User.Identity?.IsAuthenticated == true) {
                        <a class="nav-cta" href="/Account">My account</a>
                        <form method="post" asp-page="/Account/Index" asp-page-handler="Logout"><button class="text-button">Sign out</button></form>
                    } else { <a class="nav-cta" href="/auth/login">Sign in</a> }
                </nav>
            </div>
        </header>
        <main id="main">@RenderBody()</main>
        <footer>
            <span>S4 OPS v@(typeof(Alpha6Ops.Server.ServerSettings).Assembly.GetName().Version?.ToString(3) ?? "0.0.0") by Sierra 4. Built for Microsoft Flight Simulator 2024.</span>
            <span class="footer-right"><a href="/Support">Help and account security</a></span>
        </footer>
    </div>
</body>
</html>
