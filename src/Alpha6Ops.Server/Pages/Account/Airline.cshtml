@page "/Account/Airline/{id:guid}"
@model Alpha6Ops.Server.Pages.Account.AirlineModel
@{ ViewData["Title"] = Model.Overview?.Airline.Name ?? "Airline"; Layout = "_ConsoleLayout"; ViewData["ConsoleAirline"] = Model.Overview?.Airline; ViewData["ConsoleActive"] = "overview"; }
<partial name="_AccountError" model="Model" />
@if (Model.Overview is { } o) {
    var a = o.Airline;
    var ops = a.Capabilities.Contains(Capabilities.OperationsManage);
    var admin = a.Capabilities.Contains(Capabilities.MembersManage);
    var basePath = $"/Account/Airline/{a.Id}";
    @if (Model.Joined) { <p class="notice" role="status">Welcome to @a.Name. Choose this airline as your workspace on <a href="/Account">your account page</a> to fly for it in the desktop app.</p> }
    <section class="stat-row three" aria-label="Airline at a glance">
        <a class="stat" href="@basePath/Schedule"><span class="stat-label">Routes · @o.ActiveRoutes active</span><span class="stat-value">@o.Routes</span></a>
        <a class="stat" href="@basePath/Fleet"><span class="stat-label">Aircraft · @o.ActiveAircraft in service</span><span class="stat-value">@o.Aircraft</span></a>
        @if (admin) { <a class="stat" href="@basePath/Crew"><span class="stat-label">Crew@(o.PendingInvitations > 0 ? $" · {o.PendingInvitations} invited" : "")</span><span class="stat-value">@o.Crew</span></a> }
        else { <div class="stat"><span class="stat-label">Crew</span><span class="stat-value">@o.Crew</span></div> }
    </section>
    var steps = new List<(bool Done, string Title, string Hint, string Href, string Action)>();
    if (ops) {
        steps.Add((o.Routes > 0, "Add your first route", "Flight number, airports, departure time and days. Or import a CSV.", $"{basePath}/Schedule#route-form", "Add a route"));
        steps.Add((o.Aircraft > 0, "Add your first aircraft", "Registration and type, so dispatch knows what you fly.", $"{basePath}/Fleet#aircraft-form", "Add aircraft"));
    }
    if (admin) {
        steps.Add((a.LogoUrl.Length > 0, "Upload your logo", "Your crew sees it here and in the desktop app.", $"{basePath}/Settings#logo", "Upload"));
        steps.Add((o.Crew > 1, "Invite your first pilot", o.PendingInvitations > 0 ? "An invitation is waiting to be accepted." : "They accept with the email address you invite.", $"{basePath}/Crew#invite", "Invite"));
    }
    if (steps.Count > 0 && steps.Any(s => !s.Done)) {
    <section class="card getting-started" aria-labelledby="setup-title">
        <h2 id="setup-title">Set up @a.Name</h2>
        <p class="muted">@steps.Count(s => s.Done) of @steps.Count done. This card goes away once they are.</p>
        <ol class="steps-list">
        @foreach (var step in steps) {
            <li class="step @(step.Done ? "done" : "")"><span class="step-mark" aria-hidden="true"></span><div><strong><span class="visually-hidden">@(step.Done ? "Done: " : "To do: ")</span>@step.Title</strong><span class="muted block">@step.Hint</span></div>
                @if (!step.Done) { <a class="button secondary small" href="@step.Href">@step.Action</a> }</li>
        }
        </ol>
    </section>
    }
    <section class="card">
        <h2>Your part in @a.Name</h2>
        <p>Your roles: <strong>@string.Join(", ", a.Roles)</strong>.
        @if (admin) { <span>You can edit the schedule and fleet, invite crew and change their roles.</span> }
        else if (ops) { <span>You can edit the schedule and fleet. Administrators manage the crew.</span> }
        else { <span>You can read the <a href="@basePath/Schedule">schedule</a> and <a href="@basePath/Fleet">fleet</a>. Dispatchers and administrators edit them.</span> }</p>
        <p class="muted">To fly for @a.Name, choose it as your workspace on <a href="/Account">your account page</a>, then sign in to the desktop app.</p>
    </section>
}
