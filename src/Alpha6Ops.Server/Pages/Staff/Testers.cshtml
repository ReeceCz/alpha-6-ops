@page "/Staff/Testers"
@model Alpha6Ops.Server.Pages.Staff.TestersModel
@{ ViewData["Title"] = "Testers"; }
<div class="page-heading"><div class="eyebrow">Staff</div><h1>Testers</h1><partial name="_StaffNav" model='@("testers")' />
<p class="lead">S4 OPS is invite-only. Add a tester's email here, then tell them to create their account at s4ops.com with that address.</p></div>
<partial name="_AccountError" model="Model" />
@if (Model.ErrorCode is null or "invalid_email" or "invalid_invite") {
@if (Model.Requests.Length > 0) {
<section class="card" id="requests">
    <h2>Requests (@Model.Requests.Length)</h2>
    <p class="muted">From the public <a href="/Request">Ask for an invitation</a> form, oldest first. Unanswered requests are deleted after 90 days.</p>
    <ul class="report-list">
    @foreach (var r in Model.Requests) {
        <li><strong class="break">@r.Email</strong>@if (r.Name.Length > 0) { <span> · @r.Name</span> }<span class="muted block">@r.CreatedAt.ToString("yyyy-MM-dd")</span>
            @if (r.Note.Length > 0) { <p>@r.Note</p> }
            <div class="actions">
                <form method="post" asp-page-handler="Approve"><input type="hidden" name="id" value="@r.Id" /><button class="button" type="submit">Invite</button></form>
                <form method="post" asp-page-handler="Decline"><input type="hidden" name="id" value="@r.Id" /><button class="text-button" type="submit">Decline</button></form>
            </div></li>
    }
    </ul>
</section>
}
<section class="card">
    <h2>Invite a tester</h2>
    <form method="post" asp-page-handler="Add" class="stack">
        <div class="grid two">
            <div class="stack"><label for="email">Email</label><input id="email" name="email" type="email" maxlength="254" required autocomplete="off" value="@Model.Email" /></div>
            <div class="stack"><label for="note">Note (optional)</label><input id="note" name="note" maxlength="200" value="@Model.Note" placeholder="Who they are, or who asked" /></div>
        </div>
        <div class="actions"><button class="button" type="submit">Invite</button></div>
    </form>
    <p class="muted">Emails in the server's <code>Accounts__InvitedEmails</code> setting are admitted too; they aren't listed here.</p>
</section>
<section class="card">
    <h2>Message to send</h2>
    @if (Model.EmailOn) { <p class="muted">Invitation emails are on: new testers get this automatically. Use it if they can't find the email.</p> }
    else { <p class="muted">Invitation emails are off (no Resend key). After inviting someone, send them this.</p> }
    @{ var site = $"{Request.Scheme}://{Request.Host}"; }
    <textarea class="mono" rows="7" readonly aria-label="Message to send a new tester">You're invited to test S4 OPS, airline operations for Microsoft Flight Simulator 2024.

1. Create your account with this email address: @site/auth/signup
2. Verify your email, then sign in.
3. Read the tester guide, then download the app: @site/Guide

Something wrong? Use "Report a problem" in your account.</textarea>
</section>
<section class="card">
    <h2>Invited (@Model.Invites.Length)</h2>
    @if (Model.Invites.Length == 0) { <p class="muted">Nobody yet.</p> } else {
    <ul class="report-list">
    @foreach (var i in Model.Invites) {
        <li class="row"><div><strong class="break">@i.Email</strong> <span class="badge @(i.HasAccount ? "ok" : "")">@(i.HasAccount ? "Account created" : "Not signed up yet")</span>
            <span class="muted block">Invited by @i.InvitedBy · @i.CreatedAt.ToString("yyyy-MM-dd")@(i.Note.Length > 0 ? " · " + i.Note : "")</span></div>
            <form method="post" asp-page-handler="Remove"><input type="hidden" name="email" value="@i.Email" /><button class="text-button" type="submit">Remove</button></form></li>
    }
    </ul>
    }
</section>
}
